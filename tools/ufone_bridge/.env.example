# Copy to /opt/ufone-bridge/.env on the VPS (never commit real secrets).

UFONE_USERNAME=
UFONE_PASSWORD=
UFONE_ACCOUNT_ID=1

# Fleet Manager on Render
RENDER_INGEST_URL=https://fleet-management-xdvj.onrender.com
UFONE_BRIDGE_TOKEN=

# Sync cadence (seconds). 180 ~= dashboard task poll.
BRIDGE_INTERVAL_SEC=180

# Open-task close reminder minutes are per Project in Admin → Setting →
# Ufone Task Reminders (0 = off). BRIDGE_OVERDUE_MINUTES is unused.

UFONE_SESSION_DIR=/opt/ufone-bridge/sessions

# Copy to /opt/ufone-bridge/.env on the VPS (never commit real secrets).

# Render Postgres (required — UI accounts + cache writes)
DATABASE_URL=

# Same UFONE_BRIDGE_TOKEN as Render — decrypts Ufone Accounts passwords.
# Never put UFONE_USERNAME / UFONE_PASSWORD here — load from UI only.
UFONE_BRIDGE_TOKEN=

# Optional: pin sync to one ufone_account.id (0 = all active UI accounts)
UFONE_ACCOUNT_ID=0

# Fleet Manager on Render (notify / health)
RENDER_INGEST_URL=https://fleet-management-xdvj.onrender.com

# Sync cadence. Worker tick 60s for Master-Data fleet getTaskDetail every minute.
# Dashboard (Task Generate trigger) = INTERVAL * DASHBOARD_EVERY_N (60*1 = 60s).
# EMG report = INTERVAL * EMG_EVERY_N (60*6 = 360s).
BRIDGE_INTERVAL_SEC=60
BRIDGE_DASHBOARD_EVERY_N=1
BRIDGE_EMG_EVERY_N=6
BRIDGE_FAST_CLOSE_SEC=60
# Non-fleet open tasks detail rotation (popup cache only) — 6 min
BRIDGE_NONFLEET_DETAIL_SEC=360
BRIDGE_DETAIL_BATCH=15

# EMG: always fetch today. Also fetch a prior calendar day ONLY when that day
# still has In-Process tasks in DB. Max lookback window (hard-capped at 7).
BRIDGE_EMG_LOOKBACK_DAYS=7

# On-demand Task Detail HTTP (Render → VPS). 0 = disabled.
BRIDGE_DETAIL_PORT=8787

# Open-task close reminder minutes are per Project in Admin → Setting →
# Ufone Task Reminders (0 = off). BRIDGE_OVERDUE_MINUTES is unused.

UFONE_SESSION_DIR=/opt/ufone-bridge/sessions

[Unit]
Description=Ufone BPOCOPS PK VPS bridge worker (Postgres direct)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ufone-bridge
EnvironmentFile=/opt/ufone-bridge/.env
ExecStart=/opt/ufone-bridge/venv/bin/python /opt/ufone-bridge/worker_pg.py
Restart=always
RestartSec=15
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
